@model ConstructionServicesManagementSystem.Models.Client

@{
    ViewData["Title"] = "Add Client";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Add Client</h2>
        <p class="text-muted">Create a new client profile.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Full Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName"
                               class="form-label">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter client's full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber"
                               class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Address"
                               class="form-label">
                            Address
                        </label>

                        <input asp-for="Address"
                               class="form-control"
                               placeholder="Enter client's address" />

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Client
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
