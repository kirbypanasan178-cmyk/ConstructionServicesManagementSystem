@model IEnumerable<ConstructionServicesManagementSystem.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Clients</h2>
            <p class="text-muted mb-0">Manage your client profiles.</p>
        </div>

        <a asp-controller="Client"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add Client
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No clients have been added yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Phone Number</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var client in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@client.FullName</strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(client.PhoneNumber)
                                                                        ? "N/A"
                                                                        : client.PhoneNumber)
                                                                                         </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(client.Email)
                                                                        ? "N/A"
                                                                        : client.Email)
                                                                                   </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(client.Address)
                                                                        ? "N/A"
                                                                        : client.Address)
                            </td>

                                    <td>
                                        @client.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group">

                                            <a asp-controller="Client"
                                               asp-action="Details"
                                               asp-route-id="@client.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                            <a asp-controller="Client"
                                               asp-action="Edit"
                                               asp-route-id="@client.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Edit
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                                                }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>
