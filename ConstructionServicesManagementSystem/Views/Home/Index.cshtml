
@model ConstructionServicesManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Dashboard</h2>
        <p class="text-muted mb-0">
            Overview of your construction services management system.
        </p>
    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Clients -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Clients
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalClients
                            </h2>
                        </div>

                        <div class="fs-2">
                            👤
                        </div>

                    </div>
                </div>
            </div>
        </div>


        <!-- Upcoming Bookings -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Upcoming Bookings
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.UpcomingBookings
                            </h2>
                        </div>

                        <div class="fs-2">
                            📅
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Total Revenue -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Total Revenue
                            </p>

                            <h2 class="fw-bold mb-0">
                                ₱@Model.TotalRevenue.ToString("N2")
                            </h2>
                        </div>

                        <div class="fs-2">
                            💰
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Pending Amount -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Pending Amount
                            </p>

                            <h2 class="fw-bold mb-0">
                                ₱@Model.PendingAmount.ToString("N2")
                            </h2>
                        </div>

                        <div class="fs-2">
                            💳
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Upcoming Schedule -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Upcoming Schedule
                </h5>

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>

            </div>
        </div>


        <div class="card-body p-0">

            @if (Model.UpcomingSchedule.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Visit Date</th>
                                <th>Client</th>
                                <th>Booking Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var booking in Model.UpcomingSchedule)
                            {
                                <tr>

                                    <td class="px-4">
                                        @booking.VisitDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>
                                        @booking.Client.FullName
                                    </td>

                                    <td>
                                        ₱@booking.TotalAmount.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">
                        No upcoming bookings.
                    </p>
                </div>
            }

        </div>

    </div>


    <!-- Bottom Section -->
    <div class="row g-4">

        <!-- Recent Payments -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="fw-bold mb-0">
                            Recent Payments
                        </h5>

                        <a asp-controller="Payment"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">
                            View All
                        </a>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (Model.RecentPayments.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th class="px-4">Payment Date</th>
                                        <th>Billing ID</th>
                                        <th>Amount</th>
                                        <th>Payment Method</th>
                                        <th>Reference Number</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var payment in Model.RecentPayments)
                                    {
                                        <tr>

                                            <td class="px-4">
                                                @payment.PaymentDate.ToString("MMM dd, yyyy")
                                            </td>

                                            <td>
                                                #@payment.BillingId
                                            </td>

                                            <td class="fw-semibold">
                                                ₱@payment.Amount.ToString("N2")
                                            </td>

                                            <td>
                                                @payment.PaymentMethod
                                            </td>

                                            <td>
                                                @payment.ReferenceNumber
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <p class="text-muted mb-0">
                                No payments have been recorded yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <h5 class="fw-bold mb-0">
                        Quick Actions
                    </h5>

                </div>


                <div class="card-body">

                    <div class="d-grid gap-3">

                        <a asp-controller="Booking"
                           asp-action="Create"
                           class="btn btn-primary">
                            + New Booking
                        </a>

                        <a asp-controller="Client"
                           asp-action="Create"
                           class="btn btn-outline-primary">
                            + Add Client
                        </a>

                        <a asp-controller="Payment"
                           asp-action="Index"
                           class="btn btn-outline-primary">
                            Process Payment
                        </a>

                        <a asp-controller="Tool"
                           asp-action="Create"
                           class="btn btn-outline-primary">
                            + Add Tool
                        </a>

                        <a asp-controller="Reports"
                           asp-action="BillingStatement"
                           class="btn btn-outline-secondary">
                            View Reports
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

