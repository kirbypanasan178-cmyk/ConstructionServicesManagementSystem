@model IEnumerable<ConstructionServicesManagementSystem.Models.Tool>

@{
    ViewData["Title"] = "Tools Inventory";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tools & Equipment</h2>
            <p class="text-muted">
                List of available tools and equipment for each service.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Tool
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No tools or equipment have been added yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Tool / Equipment</th>
                                <th>Service</th>
                                <th>Quantity</th>
                                <th>Description</th>
                                <th>Availability</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var tool in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@tool.Name</strong>
                                    </td>

                                    <td>
                                        @tool.Service?.Name
                                    </td>

                                    <td>
                                        @tool.Quantity
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(tool.Description))
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            @tool.Description
                                        }
                                    </td>

                                    <td>
                                        @if (tool.IsAvailable && tool.Quantity > 0)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Not Available
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Edit"
                                           asp-route-id="@tool.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@tool.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
</div>