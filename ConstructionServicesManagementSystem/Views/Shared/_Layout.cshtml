
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Construction Services Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ConstructionServicesManagementSystem.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-container">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <h4>Construction Services</h4>
                <small>Management System</small>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>🏠</span>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Client"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>👤</span>
                    <span>Clients</span>
                </a>

                <a asp-controller="Schedule"
                   asp-action="Weekly"
                   class="sidebar-link">
                    <span>🗓️</span>
                    <span>Weekly Schedule</span>
                </a>

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>📅</span>
                    <span>Bookings</span>
                </a>

                <a asp-controller="HourlyRate"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>🔧</span>
                    <span>Service</span>
                </a>

                <a asp-controller="Payment"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>💳</span>
                    <span>Payments</span>
                </a>

                <a asp-controller="Reports"
                   asp-action="BillingStatement"
                   class="sidebar-link">
                    <span>📊</span>
                    <span>Reports</span>
                </a>

                <a asp-controller="Tool"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>🛠️</span>
                    <span>Inventory</span>
                </a>

            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="sidebar-link">
                    <span>🔒</span>
                    <span>Privacy</span>
                </a>
            </div>

        </aside>


        <!-- Main Area -->
        <div class="main-wrapper">

            <!-- Top Navbar -->
            <header>
                <nav class="top-navbar">

                    <div class="container-fluid">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h5 class="mb-0">@ViewData["Title"]</h5>
                            </div>

                            <div>
                                <span class="text-muted">
                                    Construction Services Management System
                                </span>
                            </div>

                        </div>

                    </div>

                </nav>
            </header>


            <!-- Page Content -->
            <main role="main" class="main-content">

                @RenderBody()

            </main>


            <!-- Footer -->
            <footer class="border-top footer text-muted">

                <div class="container-fluid">
                    &copy; 2026 - Construction Services Management System
                </div>

            </footer>

        </div>

    </div>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

