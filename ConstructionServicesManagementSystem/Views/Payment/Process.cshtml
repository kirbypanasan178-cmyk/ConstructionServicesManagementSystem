@model ConstructionServicesManagementSystem.Models.Billing

@using ConstructionServicesManagementSystem.Enums

@{
    ViewData["Title"] = "Process Payment";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">Process Payment</h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Billing Number
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.BillingNumber"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Total Amount
                        </label>

                        <input type="text"
                               class="form-control"
                               value="₱@Model.TotalAmount.ToString("N2")"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Amount Already Paid
                        </label>

                        <input type="text"
                               class="form-control"
                               value="₱@Model.AmountPaid.ToString("N2")"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Remaining Balance
                        </label>

                        <input type="text"
                               class="form-control"
                               value="₱@Model.Balance.ToString("N2")"
                               readonly />
                    </div>

                    <hr />

                    <form asp-controller="Payment"
                          asp-action="Process"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="billingId"
                               value="@Model.Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label for="amount" class="form-label">
                                Payment Amount
                            </label>

                            <input type="number"
                                   id="amount"
                                   name="amount"
                                   class="form-control"
                                   min="0.01"
                                   max="@Model.Balance"
                                   step="0.01"
                                   required />

                            <span class="text-danger">
                                @Html.ValidationMessage("amount")
                            </span>
                        </div>

                        <div class="mb-3">
                            <label for="paymentMethod" class="form-label">
                                Payment Method
                            </label>

                            <select id="paymentMethod"
                                    name="paymentMethod"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Payment Method --
                                </option>

                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method">
                                        @method
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="alert alert-info">
                            <strong>Reference Number</strong> will be
                            automatically generated after the payment is
                            processed.
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Payment"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                Process Payment
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}